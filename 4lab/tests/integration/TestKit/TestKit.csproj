<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="xunit" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\api\MurketApi\MurketApi.csproj" />
  </ItemGroup>

  <!-- Схема БД — единый источник: src/api/db/02_schema.sql (копируется рядом с тестами). -->
  <ItemGroup>
    <None Include="..\..\..\src\api\db\02_schema.sql" Link="db\02_schema.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
